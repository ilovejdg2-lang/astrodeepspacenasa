# Copiá este archivo a .env en la raíz del repositorio.
# No pongas claves reales en el repositorio ni en los logs.
# Si AI_API_KEY está vacío, la aplicación arranca igual y usa el motor local.
# El servicio de IA responde "no configurado" hasta que completes la clave.

# openai-compatible | anthropic
AI_PROVIDER=openai-compatible

# Clave del proveedor. Solo la lee el servidor.
AI_API_KEY=

# Base para proveedores compatibles con la API de chat de OpenAI.
# Ejemplos:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1

# Modelo del proveedor elegido.
AI_MODEL=gpt-4o-mini

# Tiempo máximo de una llamada, en milisegundos.
AI_TIMEOUT_MS=25000

# Puerto del servidor local de IA.
PORT=8787

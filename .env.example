# El frontend utiliza /api mediante el proxy de Vite a 127.0.0.1:3000.
# Configurar las variables AI_* únicamente en ../NASA_SPACE_APP-BACKEND/.env.
# npm run dev:api inicia el backend oficial NestJS.

# Supabase (publishable / anon). Nunca pongas la contraseña de la base aquí.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

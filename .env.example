# Local: dejar VITE_API_BASE_URL vacío. Vite proxy /api → 127.0.0.1:3000
# Producción (Vercel): URL pública del backend Nest, sin barra final.
# Ejemplo: https://helios-api.up.railway.app
VITE_API_BASE_URL=

# Supabase (publishable / anon). Nunca pongas la contraseña de la base aquí.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
